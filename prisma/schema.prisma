// =============================================================================
// FragPunk Guessr — Prisma schema
// -----------------------------------------------------------------------------
// PostgreSQL (Neon en production, `npx prisma dev` ou Neon en local) :
//  - les "enums" restent des String contraints par les unions TypeScript +
//    schémas Zod (types/game.ts) — convertibles en enums natifs plus tard
//  - coordonnées stockées en PIXELS sur l'image d'origine du plan (pixelX,
//    pixelY) ; les dimensions du plan (Floor.width/height) sont enregistrées
//    pour que le frontend fasse ses conversions
//  - les fichiers (plans, screenshots) vivent dans le dossier d'assets
//    (ASSETS_DIR, par défaut ./Maps) ; la base ne stocke que des chemins
//    relatifs, synchronisés par le scanner (features/admin/server/sync.ts)
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Utilisateurs & rôles
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid(7))
  email        String   @unique
  username     String   @unique
  // Null pour les comptes purement OAuth (Google…) — connexion sans mot de passe
  passwordHash String?
  // "USER" | "ADMIN" — extensible ("MODERATOR"…) via types/game.ts (UserRole)
  role         String   @default("USER")
  // Compte désactivé = connexion refusée (les données sont conservées)
  isActive     Boolean  @default(true)
  // — Profil public —
  displayName  String?
  avatarUrl    String?
  country      String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     GameSession[]
  stats        UserStats?
  achievements UserAchievement[]
  accounts     Account[]
}

// Liaison d'un compte externe (OAuth) à un utilisateur.
// Générique par construction : "google" aujourd'hui, "discord"/"steam"
// demain — un provider = une ligne, un utilisateur peut en lier plusieurs.
model Account {
  id                String   @id @default(cuid())
  userId            String
  // Identifiant du provider ("google", "discord", "steam"…)
  provider          String
  // Identifiant STABLE de l'utilisateur chez le provider (sub OIDC)
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Contenu : maps, étages, screenshots
// ---------------------------------------------------------------------------

model GameMap {
  id          String   @id @default(cuid())
  // Dérivé du nom du dossier d'assets (ex. "Itzamna" → "itzamna")
  slug        String   @unique
  name        String
  // Dossier de la map dans ASSETS_DIR (ex. "Itzamna")
  assetDir    String   @unique
  description String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  floors      Floor[]
  screenshots Screenshot[]
  zones       Zone[]
}

// Zone nommée d'une map ("Spawn", "Mid", "Site A"…) — gérée depuis l'admin
model Zone {
  id        String   @id @default(uuid(7))
  mapId     String
  name      String
  createdAt DateTime @default(now())

  map         GameMap      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  screenshots Screenshot[]

  @@unique([mapId, name])
  @@index([mapId])
}

model Floor {
  id    String @id @default(cuid())
  mapId String
  // Nom lisible dérivé du fichier ("1F", "2F", "B1"…)
  name  String
  // Ordre vertical : 1 = 1F, 2 = 2F, -1 = B1…
  level Int
  // Plan de l'étage, chemin relatif à ASSETS_DIR ("Itzamna/floors/1F.png")
  assetPath String @unique
  // Dimensions du plan en pixels (référentiel des pixelX/pixelY)
  width  Int
  height Int

  map         GameMap      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  screenshots Screenshot[]

  @@unique([mapId, level])
  @@index([mapId])
}

model Screenshot {
  // UUID immuable : c'est LA référence utilisée partout (gameplay compris) ;
  // le fichier (assetPath/code) peut changer sans casser les données
  id    String @id @default(uuid(7))
  mapId String
  // Null tant que le screenshot n'est pas placé sur un plan
  floorId String?
  // Chemin relatif à ASSETS_DIR ("Itzamna/screenshots/0001.png")
  assetPath String @unique
  // Numéro lisible dérivé du fichier ("0001")
  code String

  // Position en PIXELS sur l'image d'origine du plan (null = non placé)
  pixelX Int?
  pixelY Int?

  // "EASY" | "MEDIUM" | "HARD" | "IMPOSSIBLE" — null = non renseigné
  difficulty String?
  // Direction de la prise de vue en degrés (0-359, null = non renseignée)
  orientation Int?

  zoneId String?
  // Commentaires internes (jamais montrés aux joueurs)
  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  map    GameMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  floor  Floor?  @relation(fields: [floorId], references: [id], onDelete: SetNull)
  zone   Zone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  tags   Tag[]
  rounds Round[]

  @@unique([mapId, code])
  @@index([mapId])
  @@index([floorId])
  @@index([zoneId])
  @@index([isActive])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  screenshots Screenshot[]
}

// ---------------------------------------------------------------------------
// Parties & manches
// ---------------------------------------------------------------------------

model GameSession {
  id     String  @id @default(uuid(7))
  // Nullable : permet les parties anonymes avant l'arrivée des comptes
  userId String?
  // "CLASSIC" — d'autres modes viendront (types/game.ts, GameMode)
  mode   String  @default("CLASSIC")
  // "IN_PROGRESS" | "COMPLETED" | "ABANDONED" (SessionStatus)
  status String  @default("IN_PROGRESS")
  score  Int     @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  rounds Round[]

  @@index([userId])
  @@index([status])
}

// Une manche : le screenshot est tiré à la création de la session
// (jamais deux fois le même dans une partie) ; les champs guess*
// restent null tant que la manche n'est pas jouée.
model Round {
  id           String @id @default(uuid(7))
  sessionId    String
  screenshotId String
  // Position de la manche dans la partie (1..N)
  index        Int

  // Guess du joueur — pixels sur le plan de l'étage choisi
  guessX       Int?
  guessY       Int?
  guessFloorId String?
  // Distance en pixels (null si mauvaise map / mauvais étage)
  distance     Float?
  score        Int?
  timeMs       Int?

  createdAt DateTime @default(now())

  session    GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  screenshot Screenshot  @relation(fields: [screenshotId], references: [id], onDelete: Cascade)

  @@unique([sessionId, index])
  @@index([screenshotId])
}

// ---------------------------------------------------------------------------
// Statistiques & succès
// ---------------------------------------------------------------------------

model UserStats {
  id     String @id @default(cuid())
  userId String @unique

  gamesPlayed    Int   @default(0)
  roundsPlayed   Int   @default(0)
  totalScore     Int   @default(0)
  bestScore      Int   @default(0)
  averageScore   Float @default(0)
  perfectGuesses Int   @default(0)
  playTimeMs     Int   @default(0)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String  @id @default(cuid())
  // Identifiant stable utilisé par le code ("FIRST_GAME", "SHARPSHOOTER"…)
  code        String  @unique
  name        String
  description String
  icon        String?
  // Seuil générique interprété par la logique du succès (nb de parties, score…)
  threshold   Int?
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([achievementId])
}
