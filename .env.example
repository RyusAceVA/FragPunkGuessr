# =============================================================================
# FragPunk Guessr — variables d'environnement
# Copier vers .env puis remplir. NE JAMAIS commiter le fichier .env.
# =============================================================================

# --- Base de données (PostgreSQL) -------------------------------------------
# Dev local  : lancer `npm run db:dev` puis utiliser l'URL TCP affichée par
#              `npx prisma dev ls`, ex. :
#              postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# Production : URL de connexion POOLÉE Neon (Vercel Marketplace → Neon),
#              ex. : postgresql://user:pwd@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# --- Application ------------------------------------------------------------
# URL publique du site (en prod : https://ton-projet.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dossier des assets (plans + screenshots), relatif à la racine du projet
# ASSETS_DIR="Maps"

# --- Authentification -------------------------------------------------------
# Secret de signature des sessions — générer avec : npx auth secret
# (ou : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=""

# Compte administrateur unique (défini par l'environnement, pas en base)
ADMIN_EMAIL="admin@exemple.com"

# Hash Argon2id du mot de passe admin — générer avec :
#   npm run admin:hash -- "TonMotDePasseSolide"
# ⚠ Le hash contient des $ : dans un fichier .env ils doivent être échappés
#   en \$ (le script affiche la ligne prête à coller). Dans l'interface
#   Vercel, coller la valeur BRUTE (sans échappement).
ADMIN_PASSWORD_HASH=""
